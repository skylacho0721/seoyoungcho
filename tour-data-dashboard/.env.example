# 서버 포트 (선택)
PORT=3000

# 공공데이터포털(data.go.kr)에서 아래 두 API를 각각 "활용신청" 한 뒤
# 마이페이지 > 개발계정 에서 나오는 일반 인증키(Decoding) 값을 붙여넣으세요.

# 1) 한국관광공사_국문 관광정보 서비스_GW (TourAPI)
#    검색어: "한국관광공사 국문 관광정보"
TOUR_API_KEY=여기에_TourAPI_인증키_Decoding_값_입력

# 2) 기상청_단기예보 ((구)_동네예보) 조회서비스
#    검색어: "기상청 단기예보"
WEATHER_API_KEY=여기에_기상청_단기예보_인증키_Decoding_값_입력
